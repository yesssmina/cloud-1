# Cloud-1 — Docker Compose
# Architecture: 1 process = 1 container (subject requirement)
# Two networks: frontend (exposed) and backend (isolated)
# All secrets injected by Ansible from vault — no hardcoded passwords

services:

  # --- DATABASE ---
  # Backend network ONLY — no ports exposed — unreachable from internet
  db:
    image: mysql:8.0
    container_name: db
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ db_root_password }}"
      MYSQL_DATABASE: "{{ db_name }}"
      MYSQL_USER: "{{ db_user }}"
      MYSQL_PASSWORD: "{{ db_password }}"
    volumes:
      - db_data:/var/lib/mysql
    networks:
      - backend

  # --- WORDPRESS ---
  # Backend (talks to MySQL) + Frontend (reachable by Nginx)
  wordpress:
    image: wordpress:latest
    container_name: wordpress
    restart: unless-stopped
    depends_on:
      - db
    environment:
      WORDPRESS_DB_HOST: db:3306
      WORDPRESS_DB_NAME: "{{ db_name }}"
      WORDPRESS_DB_USER: "{{ db_user }}"
      WORDPRESS_DB_PASSWORD: "{{ db_password }}"
    volumes:
      - wp_data:/var/www/html
    networks:
      - backend
      - frontend

  # --- PHPMYADMIN ---
  # Backend (talks to MySQL) + Frontend (reachable by Nginx)
  phpmyadmin:
    image: phpmyadmin:latest
    container_name: phpmyadmin
    restart: unless-stopped
    depends_on:
      - db
    environment:
      PMA_HOST: db
      MYSQL_ROOT_PASSWORD: "{{ db_root_password }}"
    networks:
      - backend
      - frontend

  # --- NGINX (reverse proxy) ---
  # The only container exposing ports to internet
  nginx:
    image: nginx:latest
    container_name: nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - certbot_data:/etc/letsencrypt
      - certbot_www:/var/www/certbot
      - wp_data:/var/www/html
    depends_on:
      - wordpress
      - phpmyadmin
    networks:
      - frontend

  # --- CERTBOT ---
  # Obtains and renews TLS certificates from Let's Encrypt
  # Runs once then exits — not a long-running service
  certbot:
    image: certbot/certbot:latest
    container_name: certbot
    profiles:
      - certbot
    volumes:
      - certbot_data:/etc/letsencrypt
      - certbot_www:/var/www/certbot

volumes:
  db_data:
  wp_data:
  certbot_data:
  certbot_www:

networks:
  frontend:
  backend:
